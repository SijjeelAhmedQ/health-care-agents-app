# ---- Assistant: speech ----
# Omi Med STT, streamed live from the Python bridge (python/app.py -> /ws/stt).
VITE_STT_WS_URL=ws://127.0.0.1:8765/ws/stt

# ---- Assistant: model (tool calling) ----
# The provider alone decides where the model runs (no silent fallback to Ollama):
# ollama            -> This Computer: Ollama /api/chat with native tool calling (qwen3.5:4b) — the only use of Ollama
# vllm              -> a vLLM server /v1/chat/completions (e.g. http://127.0.0.1:8000, or the Kaggle GPU
#                      through the bridge: http://127.0.0.1:8765/vllm)
# openrouter        -> OpenRouter through the bridge, which holds the key (http://127.0.0.1:8765/openrouter/api)
# openai-compatible -> llama.cpp server / LM Studio / mlx_lm.server /v1/chat/completions
# bridge            -> the Python bridge's /api/chat (VITE_LLM_API_URL=http://127.0.0.1:8765)
VITE_LLM_PROVIDER=ollama
VITE_LLM_API_URL=http://127.0.0.1:11434
VITE_LLM_MODEL=qwen3.5:4b
# The first request after start-up loads the model and ~8k tokens of tool schemas.
VITE_LLM_TIMEOUT_MS=90000
# GPU offload: 99 = every layer on the GPU. Without it Ollama may split the model and run ~3x slower.
VITE_LLM_NUM_GPU=99
# Context window: system prompt + tool schemas (~8k tokens) + conversation + tool results.
VITE_LLM_NUM_CTX=12288
# Most model calls one utterance may take (tool call -> result -> next tool ... -> reply).
VITE_AGENT_MAX_STEPS=8
# Multi-agent mode: a master agent gives each request to five specialists (Patients, Dashboard,
# My Appointment, Summary, Inbox) as a task graph. Off = the single assistant. Also a switch in Configuration.
VITE_AGENT_MULTI=false
# Multi-agent mode: independent read-only tasks start together (UI changes and writes never overlap).
VITE_AGENT_PARALLEL_READS=true
# The Safety Agent (every mode): a value the provider did not say — a drug, a dose, a patient, a date — never
# reaches the app: it is removed, corrected from what was said, or the provider is asked. Also a switch in Configuration.
VITE_AGENT_SAFETY=true
# Multi-agent mode: the Planning Agent works out what each action needs and asks for what is missing before
# anything runs ("select patient" → "Which patient would you like to select?"). Also a switch in Configuration.
VITE_AGENT_PLANNING=true

# ---- Feature flags ----
VITE_ENABLE_VOICE=true
VITE_ENABLE_DEBUG_PANEL=true
VITE_APP_NAME=CareFlow PMS
