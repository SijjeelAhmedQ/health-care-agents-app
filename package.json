{
  "name": "health-care-pms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Voice-controlled Healthcare Practice Management System (frontend prototype)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:llm": "vitest run --config vitest.eval.config.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File python/start.ps1",
    "bridge:health": "curl -s http://127.0.0.1:8765/api/health",
    "live": "vitest run --config vitest.live.config.ts",
    "agents:json": "vitest run src/services/ai/__tests__/agentJson.test.ts --update"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "antd": "^5.22.0",
    "dayjs": "^1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
